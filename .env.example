# ============================================================
# SFAAM NEWS V12 - Environment Variables Template
# ============================================================
# Copy this file to `.env` (local dev) OR set these in Railway's
# Variables tab (production). NEVER commit the real .env file.
# ------------------------------------------------------------

# ─── CORE ────────────────────────────────────────────────────
# Public site URL (used for sitemap, OG tags, canonical URLs)
SITE_URL=https://sfaamnews.com

# Host/port for local dev (Railway auto-sets PORT)
HOST=0.0.0.0
PORT=8000

# ─── DATABASE (REQUIRED on Railway) ──────────────────────────
# Railway provides this automatically when you add PostgreSQL.
# Format: postgresql://USER:PASS@HOST:PORT/DBNAME
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── ADMIN AUTH (REQUIRED) ───────────────────────────────────
# V29: You can set EITHER ADMIN_PASSWORD (plain text) OR ADMIN_PASSWORD_HASH (SHA-256).
# If both are set, ADMIN_PASSWORD_HASH takes priority.
# If only ADMIN_PASSWORD is set, the app will auto-hash it on startup.
#
# Option 1: Set plain text password (easiest for .env file)
ADMIN_PASSWORD=your_secure_password_here
#
# Option 2: Set SHA-256 hash directly (more secure for production)
# Generate by running: python3 -c "import hashlib;print(hashlib.sha256('YOUR_PASSWORD'.encode()).hexdigest())"
# ADMIN_PASSWORD_HASH=the_sha256_hash_here
#
# Admin API key (random 32+ char string for API access).
# Generate by running: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# V29: Both ADMIN_KEY and ADMIN_API_KEY variable names are supported.
ADMIN_KEY=your_admin_api_key_here
ADMIN_API_KEY=your_admin_api_key_here

# Optional: comma-separated IP whitelist for admin endpoints.
# Example: 203.0.113.5,198.51.100.10
# Leave empty to allow any IP (with valid auth).
ADMIN_IP_WHITELIST=

# ─── REDIS (RECOMMENDED on Railway) ──────────────────────────
# Railway provides this automatically when you add Redis plugin.
# Used for distributed rate-limiting + admin session store.
# Without Redis, falls back to in-memory (single-worker only).
REDIS_URL=redis://default:password@host:6379

# ─── RATE LIMITING ───────────────────────────────────────────
# Per-IP limits. Defaults are sensible for production.
RATE_LIMIT=100
RATE_WINDOW=60
CONTACT_RATE_LIMIT=5
SUBSCRIBE_RATE_LIMIT=10

# ─── ARTICLE RETENTION ───────────────────────────────────────
# Auto-delete articles older than N days. 0 = never delete.
DELETE_AFTER_DAYS=30

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins for API.
CORS_ORIGINS=https://sfaamnews.com,https://www.sfaamnews.com

# ─── AI KEYS (REQUIRED for AI rewriting) ─────────────────────
# Per-region Groq + Gemini keys. At least one provider per region
# must be set, otherwise articles fall back to raw RSS summary.
#
# Get Groq keys (free): https://console.groq.com/keys
# Get Gemini keys (free): https://aistudio.google.com/apikey
#
# TRD v1.0 NAMING (recommended): GROQ_API_KEY_<REGION>, GEMINI_API_KEY_<REGION>
# LEGACY NAMING (still works):   GROQ_KEY_<REGION>, GEMINI_KEY_<REGION>
#
# The region_config.py module resolves BOTH names — TRD name takes priority.
# Regions (uppercase): WORLD, USA, UK, PAKISTAN, INDIA, GERMANY

# ── World ──
GROQ_API_KEY_WORLD=
GEMINI_API_KEY_WORLD=
# (legacy aliases still accepted)
# GROQ_KEY_WORLD=
# GEMINI_KEY_WORLD=

# ── USA ──
GROQ_API_KEY_USA=
GEMINI_API_KEY_USA=

# ── UK ──
GROQ_API_KEY_UK=
GEMINI_API_KEY_UK=

# ── Pakistan ──
GROQ_API_KEY_PAKISTAN=
GEMINI_API_KEY_PAKISTAN=

# ── India ──
GROQ_API_KEY_INDIA=
GEMINI_API_KEY_INDIA=

# ── Germany ──
GROQ_API_KEY_GERMANY=
GEMINI_API_KEY_GERMANY=

# ─── TREND AGGREGATOR KEYS (optional but recommended) ───────
# Used by Step A (Trend Detection) and Step B (Fact Extraction).
# At least one improves trend detection quality significantly.
#
# Tavily (best for fact extraction) — https://tavily.com
TAVILY_API_KEY=
#
# NewsAPI.org (top headlines per country) — https://newsapi.org
NEWSAPI_KEY=
#
# GNews.io (alternative headlines) — https://gnews.io
GNEWS_KEY=
#
# Perplexity API (alternative to Tavily) — https://perplexity.ai
PERPLEXITY_API_KEY=

# ─── POSTGRES POOL TUNING (optional) ─────────────────────────
# Defaults are good for Railway's small instances (512MB RAM).
PG_POOL_SIZE=10
PG_MAX_OVERFLOW=20

# ============================================================
# V24 NEW ENVIRONMENT VARIABLES
# ============================================================

# ─── ENVIRONMENT MODE ───────────────────────────────────────
# Set to "production" in Railway. Refuses to fall back to SQLite
# when DATABASE_URL is missing/invalid (prevents silent data loss).
ENV=development

# Override to allow SQLite in production (NOT recommended — ack only
# if you accept data-loss risk on container restart).
# ALLOW_PROD_SQLITE=1

# ─── DRAFT MODE (V24) ──────────────────────────────────────
# When "1", all AI-generated articles are saved as "draft" status.
# Admin must publish them manually via the admin dashboard.
# Set to "0" to auto-publish (faster but riskier — AI errors go live).
DRAFT_MODE=1

# ─── QUALITY CONTROL (V24) ────────────────────────────────
# Minimum quality score (0-100) for articles to auto-publish.
# Articles scoring below this are flagged for review or rejected.
QC_MIN_SCORE=60
QC_MIN_READABILITY=40
QC_MAX_SENTENCE_LEN=30
QC_MAX_PARA_LEN=60
QC_MIN_WORDS=300
QC_MAX_DUP_SIMILARITY=0.75

# ─── CONVERSATIONAL STYLE (V24) ───────────────────────────
# Comma-separated keywords to bold in articles (Wikipedia-beating
# style). Example: "Pakistan,USA,Election,Parliament"
BOLD_KEYWORDS=Pakistan,USA,UK,India,Germany,Parliament,Election,Supreme Court

# ─── ERROR MONITORING (V24) ───────────────────────────────
# Sentry DSN — get one at https://sentry.io (free tier: 5000 events/mo)
SENTRY_DSN=

# Better Stack DSN (alternative to Sentry) — https://betterstack.com
BETTERSTACK_DSN=

# Webhook URL for critical error alerts (Slack/Discord/Teams)
# Format: https://hooks.slack.com/services/...  OR
#         https://discord.com/api/webhooks/...
ALERT_WEBHOOK_URL=

# Audit log file path (admin actions recorded for compliance)
AUDIT_LOG_FILE=./logs/audit.log

# ─── CSRF PROTECTION (V24) ────────────────────────────────
# Set to "0" to disable CSRF (NOT recommended in production).
# When enabled, admin POST/PUT/DELETE requests must include
# X-CSRF-Token header (issued on login).
CSRF_ENABLED=1

# ─── GOOGLE SEARCH WRITER (V24) ───────────────────────────
# Optional: Google Custom Search API (paid, more reliable).
# If both set, used instead of DuckDuckGo (which is free but rate-limited).
# Get them at: https://developers.google.com/custom-search/v1/overview
GOOGLE_CSE_ID=
GOOGLE_API_KEY=
GOOGLE_SEARCH_MAX=4

# ─── TRANSLATION + TTS (V24) ──────────────────────────────
# Enable multilingual translation (Google Translate free endpoint)
ENABLE_TRANSLATION=1

# Enable AI voice narration (edge-tts + gTTS)
ENABLE_TTS=1

# Directory for TTS audio files
AUDIO_DIR=./static/audio

# ─── AUTOMATED BACKUPS (V24) ──────────────────────────────
# Daily 2 AM UTC database backup. Set to "0" to disable.
AUTO_BACKUP_ENABLED=1

# Directory where backups are saved (auto-rotated, last 7 kept)
BACKUP_DIR=/tmp

# ─── SCHEDULER LEADER ELECTION (V24) ──────────────────────
# When app is scaled horizontally (multiple instances), only the
# elected leader runs the news-fetching pipeline. Requires Redis.
# Without Redis, every instance runs the pipeline (acceptable for
# single-instance deploys only).
# LEADER_KEY is set automatically; no action needed.

# ─── RELEASE VERSION (for Sentry) ─────────────────────────
RELEASE_VERSION=sfaam-news@26.0
SENTRY_TRACES_RATE=0.1

# ============================================================
# V26 (Trends): Zero-Hallucination Content Engine
# ============================================================
# Background pipeline that runs every 6 hours:
#   1. Fetches top 7 Google trending queries
#   2. Deep-scrapes authoritative news sources (BBC, Reuters, AP, NYT, etc.)
#   3. Cross-verifies facts across 2+ sources
#   4. AI writes Wikipedia-style article using ONLY verified facts
#   5. Saves as DRAFT for admin review at /admin.html → Trends Drafts tab
# ------------------------------------------------------------

# Geo for Google Trends (2-letter country code, or empty for worldwide).
# Examples: "" (worldwide), "US", "GB", "IN", "PK", "DE"
TRENDS_GEO=

# Number of trending queries to fetch per cycle (default: 7, per PDF spec)
TRENDS_LIMIT=7

# Max number of authoritative sources to scrape per trend (default: 5)
TRENDS_MAX_SOURCES=5

# Minimum number of verified facts required to produce an article
# (default: 3 — skip a trend if fewer than 3 facts are cross-confirmed)
TRENDS_MIN_FACTS=3

# Pipeline interval in hours (default: 6, per PDF spec)
TRENDS_INTERVAL_HOURS=6

# Run the Trends pipeline once on app startup (after 15s delay)?
# Set to "0" to disable (e.g. in production where you only want scheduled runs)
TRENDS_RUN_ON_STARTUP=0

# AI provider to use for article generation:
#   "auto"      → try Groq first, then Gemini, then fallback (default)
#   "groq"      → Groq only
#   "gemini"    → Gemini only
#   "fallback"  → skip LLM, use deterministic fact-listing article
TRENDS_AI_PROVIDER=auto

# Optional: dedicated API keys for the Trends pipeline.
# If not set, the pipeline falls back to GROQ_KEY_WORLD / GEMINI_KEY_WORLD.
TRENDS_GROQ_KEY=
TRENDS_GEMINI_KEY=

# ============================================================
# V30 (SFAAM Automated News Engine / TRD v1.0)
# ============================================================
# The full TRD-compliant pipeline that runs every 3 hours across
# all 6 regions. Produces up to 6 drafts per cycle (one per region),
# up to 48 per day. Admin picks the top 5 to publish.
#
# This is the NEW engine. It coexists with the legacy V26 Trends
# pipeline — you can disable the legacy one by setting:
#   TRENDS_INTERVAL_HOURS=999999
# or by removing the start_trends_scheduler() call in main.py.
# ------------------------------------------------------------

# ─── ENGINE INTERVAL (TRD: 3-hour micro-cycle) ─────────────
# Per TRD Section 3: "runs on a 3-hour micro-cycle (triggering
# 8 times a day)". Default: 3 hours.
ENGINE_INTERVAL_HOURS=3

# Run the engine once on app startup (after 30s delay)?
# Default: "0" (recommended for production — let the scheduler handle it).
# Set to "1" for testing or first deploy.
ENGINE_RUN_ON_STARTUP=0

# ─── STEP A: TREND DETECTION (TRD Section 3) ───────────────
# Minimum trend score (0-100) for a trend to qualify.
# Lower = more permissive (more cycles produce articles).
# Higher = stricter (only very viral trends get processed).
ENGINE_MIN_TREND_SCORE=20

# ─── STEP B: FACT EXTRACTION (TRD Section 3) ───────────────
# Max sources to scrape per topic (TRD: "at least 3-5 distinct trusted publications")
ENGINE_MAX_SOURCES=5
# Min unique domains required (drops topics covered by only 1-2 sources)
ENGINE_MIN_SOURCES=3
# Min verified facts required to produce an article
ENGINE_MIN_VERIFIED_FACTS=3

# ─── STEP C: WORD COUNT TIERS (TRD Section 3) ──────────────
# These are coded in word_count_calculator.py and don't need env config:
#   Small  (3-5 facts)   → 400-600 words,   max_tokens=1500
#   Medium (6-12 facts)  → 800-1200 words,  max_tokens=3000
#   Large  (13+ facts)   → 1500-2500+ words, max_tokens=8000

# ─── STEP D: LLM RESILIENCE (TRD Section 6) ────────────────
# Exponential backoff schedule (seconds) when both Groq + Gemini
# return transient errors. Default: 2s → 4s → 8s.
# Override with comma-separated values, e.g. "1,2,4,8,16"
LLM_BACKOFF_SECONDS=2,4,8

# ─── STEP E: DRAFT MODE (TRD Section 5) ────────────────────
# Per TRD: "Direct-to-live publishing is strictly prohibited."
# All engine outputs are saved as status='draft'. The admin must
# manually publish. This setting cannot be changed to auto-publish
# from the engine — it's a TRD requirement.
# (To auto-publish legacy V26 trends articles, use DRAFT_MODE=0 above.)

# ============================================================
# ENGINE V2 — Clean Rebuild (search-driven, full-article pipeline)
# ============================================================
# The new engine described in the SFAAM spec doc: full article + image
# scraping (not just facts), NewsAPI/GNews/DuckDuckGo search-driven
# sources, images woven through the content. Saves drafts using the
# SAME database + admin dashboard as the existing engine — no frontend
# changes needed. Uses the SAME per-region GROQ_API_KEY_<REGION> /
# GEMINI_API_KEY_<REGION> keys above, plus NEWSAPI_KEY / GNEWS_KEY.
#
# This engine REPLACES the legacy V30 engine by default (V30 is
# disabled unless you explicitly re-enable it below).

# Master on/off switch for Engine V2. Default: enabled.
ENGINE2_ENABLED=1

# Re-enable the legacy V30 (facts-only) engine to run alongside V2.
# Default: 0 (disabled) so only Engine V2 produces drafts.
ENGINE_V30_ENABLED=0

# How often Engine V2 runs a full 6-region cycle, in hours (spec: 3).
ENGINE2_INTERVAL_HOURS=3

# How many regions run AT ONCE per cycle (spec says all 6 in parallel, but
# that risks OOM on small instances like Railway Hobby/Free 512MB-1GB RAM).
# Default: 2 at a time (safe). Raise to 6 only on a bigger instance (2GB+ RAM).
ENGINE2_MAX_CONCURRENT_REGIONS=2

# Run one cycle immediately on app startup (useful for testing).
# Default: 0 (wait for the first scheduled interval).
ENGINE2_RUN_ON_STARTUP=0

# NEWSAPI_KEY / GNEWS_KEY are shared with the legacy engine — see the
# "TREND AGGREGATOR KEYS" section above. Engine V2 needs at least one
# of them set; without both, it falls back to DuckDuckGo scraping only
# (works, but less reliable).

# ============================================================
# PRO 1 — World-class news platform environment variables
# ============================================================

# ─── CONTENT SECURITY POLICY ────────────────────────────────
# Set to "true" to switch CSP from report-only to ENFORCING mode.
# Keep false for the first week after deploy to monitor violations
# at /csp-report, then flip to true once clean.
PRO_CSP_ENFORCE=false

# ─── WEB PUSH NOTIFICATIONS (VAPID) ─────────────────────────
# Required for /api/push/* endpoints to actually send pushes.
# Generate by running: python pro_push.py --generate-keys
PRO_VAPID_PUBLIC_KEY=
PRO_VAPID_PRIVATE_KEY=
PRO_VAPID_SUBJECT=mailto:editor@sfaamnews.com

# ─── EMAIL DIGESTS (SMTP) ───────────────────────────────────
# Used by pro_digests.py to send daily/weekly personalized emails.
# Without SMTP_HOST set, digests are logged to console (dev mode).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# Amazon SES:    SMTP_HOST=email-smtp.us-east-1.amazonaws.com, SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SFAAM NEWS <digest@sfaamnews.com>

# ─── PERSONALIZATION ────────────────────────────────────────
# Set to "1" to enable the personalized "For You" feed on the homepage.
# Reading history is always tracked (anonymous fingerprint); this
# flag controls whether the feed is shown.
PRO_PERSONALIZATION_ENABLED=1

# ─── OG IMAGE GENERATION ────────────────────────────────────
# Requires Pillow (already in requirements.txt). Generated images
# are cached in static/og-cache/ for 24h.
PRO_OG_IMAGE_ENABLED=1

# ─── A/B TESTING ────────────────────────────────────────────
# Set to "1" to enable headline A/B testing. Articles get assigned
# to variant A or B on first view, and outcomes are tracked.
PRO_AB_TESTING_ENABLED=0
